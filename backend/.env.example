# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Ollama (lokal, no key needed) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# Embedding model — mxbai-embed-large: 1536 dim native, no padding, apple-to-apple dengan OpenAI
# Setup: ollama pull mxbai-embed-large
OLLAMA_EMBED_MODEL=mxbai-embed-large


# ── Github Integration ──────────────────────────────────────────────────────────────────
# Generate di: https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your_github_username


# ── Google Calendar Integration ──────────────────────────────────────────────────────────────────
# Setup : python scripts/setup_google_calendar.py (jalankan sekali)
# Download credentials dari : https://console.cloud.google.com
# Enable : Google Calendar API -> OAuth2 credentials (Desktop App)
GOOGLE_CALENDAR_CREDENTIALS_FILE=path/ke/credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=calendar_token.json

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/prometheus

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true
